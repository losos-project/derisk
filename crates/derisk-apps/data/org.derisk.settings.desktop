[Desktop Entry]
Type=Application
Name=Settings
GenericName=System Settings
Comment=Appearance, wallpaper, top bar, desktop, assistant, input, shortcuts, privacy, users, notifications, power, and backups
Keywords=preferences;theme;accent;keyboard;power;wallpaper;background;shortcuts;panel;privacy;flatpak;permissions;camera;location;backup;losos;users;accounts;administrator;assistant;ollama;model;
Icon=preferences-system
Exec=derisk launch org.derisk.settings
Categories=Settings;
Actions=appearance;wallpaper;top-bar;desktop;assistant;input;shortcuts;privacy;users;notifications;power;backups;about;

[Desktop Action appearance]
Name=Appearance
Exec=derisk launch org.derisk.settings --action appearance

[Desktop Action wallpaper]
Name=Wallpaper
Exec=derisk launch org.derisk.settings --action wallpaper

[Desktop Action top-bar]
Name=Top Bar
Exec=derisk launch org.derisk.settings --action top-bar

[Desktop Action desktop]
Name=Desktop
Exec=derisk launch org.derisk.settings --action desktop

